{
  "_meta": {
    "purpose": "Deterministic classification of job-search emails.",
    "version": "0.1.0",
    "spec_note": "The original spec's section 19 was not supplied. These categories are DERIVED from an ordinary job-search inbox. Edit freely.",
    "determinism": "Classification is rule-based: a category is assigned when its patterns match, scored by pattern weight. The category, the matched pattern and the score are all returned, so every classification can be explained. No LLM decides the category.",
    "privacy": "Only messages in an application thread, or from an application employer domain, reach this code. The rest of the mailbox is never read into Career Scout - see career_scout/gmail/poll.py.",
    "maps_to": "Each category names the stored reply class it becomes (reply.classification allows acknowledgement, rejection, interview_invite, offer, information_request, unclassified). Recruiter outreach and marketing map to unclassified: neither is a reply to an application."
  },
  "categories": [
    {
      "id": "interview_invitation",
      "label": "Interview invitation",
      "priority": 1,
      "action": "Respond within 24 hours. Add to calendar.",
      "patterns": [
        {
          "weight": 5,
          "regex": "invite you (to|for) an? (interview|call|conversation)"
        },
        {
          "weight": 5,
          "regex": "schedule (a|an|your) (interview|call|screening|chat)"
        },
        {
          "weight": 4,
          "regex": "\\b(interview|screening call) (invitation|invite)\\b"
        },
        {
          "weight": 4,
          "regex": "would you be available (for|to)"
        },
        {
          "weight": 3,
          "regex": "book a time|pick a slot|calendly\\.com|choose a time that"
        },
        {
          "weight": 3,
          "regex": "next (step|stage) (in|of) (the|our) (process|hiring)"
        }
      ],
      "maps_to": "interview_invite"
    },
    {
      "id": "rejection",
      "label": "Rejection",
      "priority": 4,
      "action": "Log it, close the pipeline entry, and ask for feedback if the stage was late.",
      "patterns": [
        {
          "weight": 5,
          "regex": "(not|unable to) (to )?(be )?(moving|move|proceed|progress)(ing)? (forward|ahead) with your"
        },
        {
          "weight": 5,
          "regex": "decided (to|not to) (proceed|move forward|continue) with (other|another)"
        },
        {
          "weight": 4,
          "regex": "we (have )?(selected|chosen) (another|other) candidate"
        },
        {
          "weight": 4,
          "regex": "your application (was|has been) (unsuccessful|declined)"
        },
        {
          "weight": 3,
          "regex": "will not be (progressing|proceeding)"
        },
        {
          "weight": 3,
          "regex": "keep your (cv|resume|details) on file"
        },
        {
          "weight": 2,
          "regex": "wish you (all the best|every success|luck) (in|with) your (job )?search"
        }
      ],
      "maps_to": "rejection"
    },
    {
      "id": "offer",
      "label": "Offer",
      "priority": 0,
      "action": "Read carefully. Do not accept or decline through this system - respond yourself.",
      "patterns": [
        {
          "weight": 5,
          "regex": "(pleased|delighted|happy) to (offer you|extend (you )?(an|this|the) offer)"
        },
        {
          "weight": 5,
          "regex": "\\boffer of employment\\b|\\bemployment offer\\b|\\boffer letter\\b"
        },
        {
          "weight": 4,
          "regex": "we would like to offer you"
        },
        {
          "weight": 3,
          "regex": "(compensation|salary) package (of|is|will be)"
        }
      ],
      "maps_to": "offer"
    },
    {
      "id": "assessment_request",
      "label": "Assessment or task",
      "priority": 2,
      "action": "Note the deadline immediately.",
      "patterns": [
        {
          "weight": 5,
          "regex": "(technical|online|coding|skills) (assessment|test|challenge)"
        },
        {
          "weight": 4,
          "regex": "take[- ]home (task|assignment|exercise|test)"
        },
        {
          "weight": 4,
          "regex": "complete (the|this|an) (assessment|questionnaire|test) (by|before|within)"
        },
        {
          "weight": 3,
          "regex": "hackerrank|codility|testgorilla|hirevue|sova\\.assessment"
        },
        {
          "weight": 3,
          "regex": "psychometric|aptitude test"
        }
      ],
      "maps_to": "information_request"
    },
    {
      "id": "document_request",
      "label": "Documents or information requested",
      "priority": 2,
      "action": "Gather the documents. Most are already in data/source_documents.",
      "patterns": [
        {
          "weight": 4,
          "regex": "please (send|provide|share|upload|attach)"
        },
        {
          "weight": 4,
          "regex": "(copy of your|copies of your) (passport|degree|transcript|certificate|cv|resume)"
        },
        {
          "weight": 3,
          "regex": "right to work|proof of (address|identity|qualification)"
        },
        {
          "weight": 3,
          "regex": "reference(s)? (details|contact)|referee"
        },
        {
          "weight": 3,
          "regex": "(notice period|salary expectation|availability)\\??"
        }
      ],
      "maps_to": "information_request"
    },
    {
      "id": "application_acknowledgement",
      "label": "Application received",
      "priority": 5,
      "action": "No action. Confirms the application landed.",
      "patterns": [
        {
          "weight": 5,
          "regex": "(we (have )?received|thank you for) your application"
        },
        {
          "weight": 4,
          "regex": "application (has been |was )?(received|submitted successfully)"
        },
        {
          "weight": 3,
          "regex": "thank you for (applying|your interest in)"
        },
        {
          "weight": 2,
          "regex": "we are reviewing (all )?applications"
        }
      ],
      "maps_to": "acknowledgement"
    },
    {
      "id": "recruiter_outreach",
      "label": "Recruiter outreach",
      "priority": 3,
      "action": "Assess whether the role is real and relevant before replying.",
      "patterns": [
        {
          "weight": 4,
          "regex": "came across your (profile|cv|resume)"
        },
        {
          "weight": 4,
          "regex": "i am a (recruiter|talent|technical) (partner|acquisition|sourcer)"
        },
        {
          "weight": 3,
          "regex": "(opportunity|role|position) (that )?(might|may|could) (be of interest|interest you)"
        },
        {
          "weight": 3,
          "regex": "are you (open|available) to (new opportunities|a conversation)"
        }
      ],
      "maps_to": "unclassified"
    },
    {
      "id": "visa_or_relocation",
      "label": "Visa or relocation",
      "priority": 2,
      "action": "Relevant to sponsorship. Read in full.",
      "patterns": [
        {
          "weight": 5,
          "regex": "(visa|work permit) (sponsorship|application|process)"
        },
        {
          "weight": 4,
          "regex": "certificate of sponsorship|\\bcos\\b|labour market|lmia"
        },
        {
          "weight": 4,
          "regex": "relocation (package|assistance|allowance)"
        },
        {
          "weight": 3,
          "regex": "immigration|right to work in"
        }
      ],
      "maps_to": "information_request"
    },
    {
      "id": "spam_or_marketing",
      "label": "Marketing or irrelevant",
      "priority": 9,
      "action": "Ignore.",
      "patterns": [
        {
          "weight": 4,
          "regex": "unsubscribe|manage (your )?(email )?preferences"
        },
        {
          "weight": 3,
          "regex": "(webinar|newsletter|course|bootcamp|certification) (invite|offer|discount)"
        },
        {
          "weight": 3,
          "regex": "limited time offer|\\d+% off"
        }
      ],
      "maps_to": "unclassified"
    }
  ],
  "classification_rules": {
    "method": "Sum the weights of every matching pattern per category. The category with the highest total wins. Ties are broken by the lower priority number.",
    "minimum_score_to_classify": 4,
    "below_minimum": "unclassified",
    "below_minimum_behaviour": "Returned as 'unclassified' with the partial scores attached. It is NOT forced into the nearest category - a guess presented as a classification is exactly the kind of invented output Rule 1 forbids.",
    "search_queries": [
      "newer_than:30d (application OR interview OR recruiter OR position OR role OR vacancy)",
      "newer_than:30d (offer OR rejection OR unsuccessful)",
      "newer_than:30d (visa OR sponsorship OR relocation)"
    ]
  }
}
